.custom-tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
}

.custom-tabbar-cover-shell {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  z-index: 320;
}

.custom-tabbar-cover {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8rpx;
  padding: 14rpx 18rpx 16rpx;
  border-radius: 36rpx;
  background: rgba(24, 24, 28, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 -12rpx 34rpx rgba(0, 0, 0, 0.24);
}

.custom-tabbar-cover__item,
.custom-tabbar-cover__center {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-tabbar-cover__item {
  height: 82rpx;
  border-radius: 26rpx;
}

.custom-tabbar-cover__item--active {
  background: rgba(75, 142, 255, 0.14);
}

.custom-tabbar-cover__icon {
  width: 48rpx;
  height: 48rpx;
}

.custom-tabbar-cover__center {
  transform: translateY(-20rpx);
}

.custom-tabbar-cover__add {
  width: 108rpx;
  height: 108rpx;
  border-radius: 999rpx;
  background: #adc6ff;
  border: 6rpx solid rgba(24, 24, 28, 0.96);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 22rpx 48rpx rgba(173, 198, 255, 0.30),
    0 0 0 8rpx rgba(24, 24, 28, 0.72);
}

.custom-tabbar-cover__plus {
  margin-top: -4rpx;
  color: #163c72;
  font-size: 66rpx;
  line-height: 1;
}

.custom-tabbar {
  position: relative;
  z-index: 220;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8rpx;
  padding: 16rpx 22rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: rgba(24, 24, 28, 0.96);
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 -12rpx 34rpx rgba(0, 0, 0, 0.24);
}

.custom-tabbar__item,
.custom-tabbar__center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.custom-tabbar__icon {
  width: 48rpx;
  height: 48rpx;
}

.custom-tabbar__label {
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 1.2;
  color: #8e97aa;
  text-align: center;
}

.custom-tabbar__label--active {
  color: #4b8eff;
}

.custom-tabbar__center {
  transform: translateY(-30rpx);
}

.custom-tabbar__add {
  width: 124rpx;
  height: 124rpx;
  border-radius: 999rpx;
  background: #adc6ff;
  color: #163c72;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 22rpx 48rpx rgba(173, 198, 255, 0.30),
    0 0 0 10rpx rgba(24, 24, 28, 0.72);
  border: 6rpx solid rgba(24, 24, 28, 0.96);
  box-sizing: border-box;
}

.custom-tabbar__add-plus {
  margin-top: -4rpx;
  font-size: 70rpx;
  line-height: 1;
  font-weight: 500;
}

.quick-add-overlay {
  position: fixed;
  inset: 0;
  z-index: 520;
  background: rgba(7, 7, 10, 0.52);
  backdrop-filter: blur(10px);
}

.quick-add-sheet-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 106rpx);
  z-index: 530;
  padding: 0 18rpx 12rpx;
  box-sizing: border-box;
}

.quick-add-sheet {
  padding: 0 18rpx 18rpx;
  box-sizing: border-box;
  border-radius: 34rpx;
  background: var(--bg-soft);
  border: 1rpx solid var(--border);
  box-shadow: 0 -20rpx 50rpx rgba(0, 0, 0, 0.28);
  overflow: hidden;
}

.quick-add-sheet__grabber {
  width: 92rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  margin: 16rpx auto 0;
}

.quick-add-sheet__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 24rpx 18rpx;
}

.quick-add-sheet__header-main {
  min-width: 0;
  flex: 1;
}

.quick-add-sheet__title {
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--text);
}

.quick-add-sheet__subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted);
}

.quick-add-sheet__close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
  font-size: 30rpx;
}

.quick-add-sheet__body {
  max-height: 72vh;
  padding: 0 24rpx 22rpx;
  box-sizing: border-box;
}

.quick-add-sheet__body .field-card + .field-card {
  margin-top: 16rpx;
}

.quick-add-section {
  margin: 26rpx 0 14rpx;
}

.quick-add-textarea {
  min-height: 138rpx;
}

.quick-add-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.quick-add-picker__value {
  min-width: 0;
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.quick-add-picker__action {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
}

.quick-add-actions {
  margin-top: 18rpx;
}
