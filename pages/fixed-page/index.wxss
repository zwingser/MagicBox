.fixed-page-root {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0;
  box-sizing: border-box;
}

.fixed-page-web-shell {
  position: relative;
  flex: 1;
  min-height: 100vh;
}

.fixed-page-header-shell {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 121;
  background: #131315;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.fixed-page-header-home {
  position: absolute;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fixed-page-header-home__icon {
  width: 26px;
  height: 26px;
}

.fixed-page-header-title {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f5f3f7;
  font-size: 17px;
  line-height: 44px;
  font-weight: 600;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fixed-page-blank {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fixed-page-state-shell {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  top: calc(env(safe-area-inset-top) + 28rpx);
  z-index: 80;
}

.fixed-page-state-card {
  width: 100%;
  padding: 34rpx 30rpx;
}

.fixed-page-card {
  width: 100%;
  padding: 42rpx 34rpx;
}

.fixed-page-card__title {
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--text);
}

.fixed-page-card__subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--muted);
}

.fixed-page-url {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--border);
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}
