<view class="page-root {{themeClass}} page-root--modal">
  <view class="safe-top"></view>

  <view class="page-header">
    <view class="action-row">
      <view class="icon-action folder-back" bindtap="goBack">{{backLabel}}</view>
    </view>
    <view class="page-header__main folder-header__main">
      <view class="page-title page-title--compact">{{folderTitle}}</view>
      <view class="page-subtitle">{{folderDesktopLabel}} - {{itemCount}} items</view>
    </view>
    <view class="action-row">
      <view class="action-chip" bindtap="onFolderMenu">Manage</view>
    </view>
  </view>

  <view class="section-label">ITEMS</view>
  <view class="helper-text">Tap to open. Long press for layout and destination actions.</view>

  <view wx:if="{{items.length}}" class="surface-card list-card">
    <view wx:for="{{items}}" wx:key="id" class="list-row" data-id="{{item.id}}" hover-class="list-row--active" hover-stay-time="80" bindtap="onItemTap" bindlongpress="onItemMenu">
      <view class="list-row__icon" style="background: {{item.color}};">{{item.badge}}</view>
      <view class="list-row__main">
        <view class="list-row__title">{{item.title}}</view>
        <view class="list-row__subtitle">{{item.metaLabel}}</view>
      </view>
      <view class="list-row__meta">{{item.typeLabel}}</view>
    </view>
  </view>

  <view wx:else class="glass-card empty-card">This folder has no items yet.</view>

  <view class="glass-card folder-summary">
    <view class="feature-card__badge" style="background: {{folderColor}};">{{folderBadge}}</view>
    <view class="folder-summary__text">
      <view class="folder-summary__title">Folder</view>
      <view class="folder-summary__meta">Use long press on any item to move it out or delete it.</view>
    </view>
  </view>

  <view class="surface-card field-card folder-rename-card">
    <view class="field-label">Folder name</view>
    <input class="inline-input" placeholder="Rename folder" placeholder-class="inline-input-placeholder" value="{{renameDraft}}" bindinput="onRenameInput" />
    <view class="btn-row">
      <button class="primary-btn" bindtap="onRenameSave">Save</button>
    </view>
  </view>
</view>
